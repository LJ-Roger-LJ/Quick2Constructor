<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>
  <Include href="VSGlobals.vsct"/>

  <Commands package="Quick2Constructor">
    <Groups>
      <Group guid="Quick2Constructor" id="MyMenuGroup" priority="0x0600">
        <Parent guid="VSMainMenu" id="CodeWindow.ContextMenu"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="Quick2Constructor" id="MyCommand" priority="0x0100" type="Button">
        <Parent guid="Quick2Constructor" id="MyMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="GoToSourceCode" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Go to Constructor</ButtonText>
          <LocCanonicalName>.Edit.GotoConstructor</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <KeyBinding guid="Quick2Constructor" id="MyCommand" editor="guidVSStd97" key1="C" mod1="Control Alt Shift" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="Quick2Constructor" value="{3859791a-57a2-47bd-85c9-6d4b0b2687ba}">
      <IDSymbol name="MyMenuGroup" value="0x0001" />
      <IDSymbol name="MyCommand" value="0x0100" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
